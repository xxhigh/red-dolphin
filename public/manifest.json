{
    "manifest_version": 3,
    "name": "Red Dolphin for SKALA",
    "description": "Student Utility for SKALA ULSAN",
    "version": "1.0.2",
    "action": {
        "default_title": "Red Dolphin",
        "default_popup": "popup.html",
        "default_icon": {
            "32": "icons/icon32x32.png",
            "96": "icons/icon96x96.png",
            "128": "icons/icon128x128.png"
        }
    },
    "background": {
        "service_worker": "assets/background.js",
        "type": "module"
    },
    "options_page": "options.html",
    "permissions": [
        "alarms",
        "storage",
        "scripting",
        "declarativeNetRequestWithHostAccess"
    ],
    "host_permissions": [
        "https://auth.skala-ai.com/*",
        "https://accounts.google.com/*",
        "https://att.skala-ai.com/*",
        "https://lms.skala-ai.com/*"
    ],
    "icons": {
        "16": "icons/icon16x16.png",
        "32": "icons/icon32x32.png",
        "48": "icons/icon48x48.png",
        "96": "icons/icon96x96.png",
        "128": "icons/icon128x128.png"
    }
}
